#############################################################################
##
#W  Makefile                    GAP source                       Frank Celler
##
##
#Y  Copyright (C)  1997,  Lehrstuhl D fuer Mathematik,  RWTH Aachen,  Germany
##
##  This is the make file of XGAP.  It is generated from `Makefile.in' by the
##  `configure' script.  After unpacking XGAP you simply type
##
##    ./configure
##
##  to create a make file and then
##
##    make
##
##  to compile and link XGAP.
##
##  The "default" target compiles the sources in `src.x11' and puts the
##  object files and the executable into the subdirectory CPU-VENDOR-OS of
##  the directory `bin'.
##
##  The "clean" target removes that subdirectory, "distclean" also removes
##  any files created by `configure'.
##
SHELL    = /bin/sh
@SET_MAKE@

CC       = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS   = @CFLAGS@
LDFLAGS  = @LDFLAGS@
LIBS     = @LIBS@
X_LIBS   = @X_LIBS@ -lXaw -lXmu -lXt -lXext -lX11 @X_PRE_LIBS@ @X_EXTRA_LIBS@
X_CFLAGS = @X_CFLAGS@

BINDIR   = bin/@GAPARCH@

SOURCES  = xcmds utils gapgraph gaptext pty popdial xgap selfile
OBJECTS  = $(SOURCES:%=$(BINDIR)/%.o)

default: $(BINDIR)/xgap bin/xgap.sh

$(BINDIR)/xgap: $(OBJECTS)
	$(CC) -o $@ $(OBJECTS) $(CFLAGS) $(LDFLAGS) $(LIBS) $(X_LIBS) $(LOPTS)

# every object depends on all headers, which is more than needed but cheap
$(OBJECTS): $(BINDIR)/%.o: src.x11/%.c src.x11/*.h src.x11/bitmaps/*.bm config.h
	@mkdir -p $(BINDIR)
	$(CC) -I. $(CPPFLAGS) $(CFLAGS) $(X_CFLAGS) $(COPTS) -o $@ -c $<

bin/xgap.sh: xgap.sh
	@mkdir -p bin
	cp xgap.sh bin/xgap.sh

xgap.sh: xgap.sh.in config.status
	./config.status xgap.sh

clean:
	rm -rf $(BINDIR)
	rm -f xgap.sh bin/xgap.sh

distclean: clean
	rm -f config.cache config.h config.log config.status Makefile

.PHONY: default clean distclean
